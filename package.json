{
  "name": "design-isms",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "images:thumbs": "node scripts/generate-thumbnails.mjs",
    "images:audit": "node scripts/audit-effect-guides.mjs",
    "images:contact-sheet": "node scripts/build-effect-guide-contact-sheet.mjs",
    "images:contact-sheets": "node scripts/build-ism-contact-sheet.mjs && node scripts/build-effect-guide-contact-sheet.mjs",
    "images:finalize-quality": "node scripts/finalize-image-quality.mjs",
    "sot:check": "node scripts/sync-sot.mjs --check",
    "sot:sync": "node scripts/sync-sot.mjs --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:generated": "node scripts/verify-generated.mjs",
    "verify:nav": "node scripts/verify-nav.mjs",
    "verify:isms": "node scripts/verify-isms.mjs",
    "verify:effects": "node scripts/verify-effects.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:image-quality": "node scripts/verify-image-quality.mjs",
    "verify:lines": "node scripts/verify-line-limits.mjs",
    "qa:static": "node scripts/run-final-static-qa.mjs",
    "qa:server": "node scripts/run-final-server-qa.mjs",
    "qa:local:browser": "node scripts/run-final-browser-qa.mjs",
    "qa:local:preserve:start": "node scripts/final-preservation.mjs start",
    "qa:local:preserve:final": "node scripts/final-preservation.mjs final",
    "verify:local-final": "node scripts/verify-final-qa.mjs",
    "verify": "npm run typecheck && npm run verify:generated && npm run verify:nav && npm run verify:isms && npm run verify:effects && npm run verify:snippets && npm run verify:finder && npm run verify:content && npm run verify:catalog && npm run verify:assets && npm run verify:image-quality && npm run verify:lines",
    "verify:snippets": "node scripts/verify-snippets.mjs",
    "verify:finder": "node scripts/verify-finder.mjs",
    "pages:stage": "node scripts/stage-pages.mjs",
    "serve": "node scripts/serve-static.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
